Description: fix: mark client-rendered damage for backing first-frame gating
 During the window-map-to-first-client-frame window, the composite backing
 pixmap of an override-redirect window holds a CopyArea residue that must
 not be shown. Mark damage whose source is client rendering (clientMark
 set in damageDamageBox and Present) and flip _DDE_NET_WM_BACKING_PIXMAP_STATE
 from 0 to 1 when such content first reaches a Manual backing; the
 temporary Manual sensor is then unregistered.
Author: UnionTech <support@uniontech.com>
Forwarded: not-needed
Last-Update: 2026-09-09
---
Index: xorg-server/composite/compalloc.c
===================================================================
--- xorg-server.orig/composite/compalloc.c
+++ xorg-server/composite/compalloc.c
@@ -544,6 +544,26 @@ compNewPixmap(WindowPtr pWin, int x, int
     pPixmap->screen_x = x;
     pPixmap->screen_y = y;
 
+    {
+        CompWindowPtr cwManual = GetCompWindow(pWin);
+
+        if (cwManual && cwManual->update == CompositeRedirectManual) {
+            xRectangle rect = { 0, 0, w, h };
+            GCPtr pZeroGC = GetScratchGC(pWin->drawable.depth, pScreen);
+
+            if (pZeroGC) {
+                ChangeGCVal cval;
+
+                cval.val = 0;
+                ChangeGC(NullClient, pZeroGC, GCForeground, &cval);
+                ValidateGC(&pPixmap->drawable, pZeroGC);
+                (*pZeroGC->ops->PolyFillRect) (&pPixmap->drawable, pZeroGC, 1, &rect);
+                FreeScratchGC(pZeroGC);
+            }
+            return pPixmap;
+        }
+    }
+
     if (pParent->drawable.depth == pWin->drawable.depth) {
         GCPtr pGC = GetScratchGC(pWin->drawable.depth, pScreen);
 
